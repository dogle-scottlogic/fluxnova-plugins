<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="agent-history-1" author="fluxnova">
        <comment>Create ACT_HI_AGENT_SUBPROCESS: one row per agent subprocess execution</comment>
        <createTable tableName="ACT_HI_AGENT_SUBPROCESS">
            <column name="ID_" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="PROC_INST_ID_" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="EXECUTION_ID_" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="PROC_DEF_KEY_" type="VARCHAR(255)"/>
            <column name="ELEMENT_ID_" type="VARCHAR(255)"/>
            <column name="PROVIDER_" type="VARCHAR(64)"/>
            <column name="MODEL_" type="VARCHAR(255)"/>
            <column name="GOAL_" type="CLOB"/>
            <column name="START_TIME_" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="END_TIME_" type="TIMESTAMP"/>
            <column name="FINAL_OUTPUT_" type="CLOB"/>
            <column name="ITERATION_COUNT_" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="TOTAL_PROMPT_TOKENS_" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="TOTAL_COMPLETION_TOKENS_" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="REMOVAL_TIME_" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="ACT_HI_AGENT_SUBPROCESS" indexName="IDX_HI_AGENT_SUB_PROC_INST">
            <column name="PROC_INST_ID_"/>
        </createIndex>
        <createIndex tableName="ACT_HI_AGENT_SUBPROCESS" indexName="IDX_HI_AGENT_SUB_REMOVAL">
            <column name="REMOVAL_TIME_"/>
        </createIndex>
    </changeSet>

    <changeSet id="agent-history-2" author="fluxnova">
        <comment>Create ACT_HI_AGENT_STEP: append-only step events for loops, LLM calls, tool calls</comment>
        <createTable tableName="ACT_HI_AGENT_STEP">
            <column name="ID_" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="SUBPROCESS_EXECUTION_ID_" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="PROC_INST_ID_" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="EVENT_TYPE_" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="SEQUENCE_COUNTER_" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="TIMESTAMP_" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="LOOP_INDEX_" type="INT"/>
            <column name="TOOL_CALL_ID_" type="VARCHAR(255)"/>
            <column name="TOOL_NAME_" type="VARCHAR(255)"/>
            <column name="TOOL_ELEMENT_ID_" type="VARCHAR(255)"/>
            <column name="PROMPT_TOKENS_" type="BIGINT"/>
            <column name="COMPLETION_TOKENS_" type="BIGINT"/>
            <column name="RESPONSE_TYPE_" type="VARCHAR(16)"/>
            <column name="TOOL_CALL_COUNT_" type="INT"/>
            <column name="DURATION_MS_" type="BIGINT"/>
            <column name="STATUS_" type="VARCHAR(16)"/>
            <column name="ERROR_MESSAGE_" type="CLOB"/>
            <column name="REMOVAL_TIME_" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="ACT_HI_AGENT_STEP" indexName="IDX_HI_AGENT_STEP_SUB_EXEC">
            <column name="SUBPROCESS_EXECUTION_ID_"/>
        </createIndex>
        <createIndex tableName="ACT_HI_AGENT_STEP" indexName="IDX_HI_AGENT_STEP_PROC_INST">
            <column name="PROC_INST_ID_"/>
        </createIndex>
        <createIndex tableName="ACT_HI_AGENT_STEP" indexName="IDX_HI_AGENT_STEP_REMOVAL">
            <column name="REMOVAL_TIME_"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
