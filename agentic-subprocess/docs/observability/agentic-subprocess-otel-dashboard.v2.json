          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${datasource}" },
                    "spec": {
                      "expr": "sum(rate(${metric_prefix}gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name=\"execute_tool\"}[5m]))",
                      "legendFormat": "execute_tool",
                      "range": true,
                      "instant": false
                    }
                  }
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "13.1.1",
          "spec": {
            "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
            "options": {}
          }
        }
      }
    },
    "panel-3": {
      "kind": "Panel",
      "spec": {
        "id": 3,
        "title": "Tool Call Error Rate",
        "description": "Fraction of tool call spans/metrics recorded with error.type set (i.e. failed tool calls).",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${datasource}" },
                    "spec": {
                      "expr": "sum(rate(${metric_prefix}gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name=\"execute_tool\",error_type=\"tool_error\"}[5m])) / sum(rate(${metric_prefix}gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name=\"execute_tool\"}[5m]))",
                      "legendFormat": "error rate",
                      "range": true,
                      "instant": false
                    }
                  }
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "13.1.1",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "unit": "percentunit",
                "decimals": 1,
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": 0 },
                    { "color": "orange", "value": 0.05 },
                    { "color": "red", "value": 0.2 }
                  ]
                }
              },
              "overrides": []
            },
            "options": {}
          }
        }
      }
    },
    "panel-4": {
