{
  "title": "Agentic Subprocess - GenAI OTEL Metrics",
  "description": "Dashboard for the gen_ai.client.operation.duration and gen_ai.client.token.usage instruments emitted by agentic-subprocess (agent-history/otel/AgentOtelMetrics) via fluxnova-engine-plugin-otel. Targets Prometheus (or a Prometheus-compatible store) reached via an OTel Collector. Assumes standard OTel->Prometheus naming (dots -> underscores, unit appended, _bucket/_sum/_count suffixes on histograms) - adjust the 'metric_prefix' variable, or the queries directly, if your collector renames metrics.",
  "tags": ["agentic-subprocess", "genai", "otel"],
  "editable": true,
  "liveNow": false,
  "preload": false,
  "cursorSync": "Off",
  "links": [],
  "annotations": [],
  "timeSettings": {
    "timezone": "browser",
    "from": "now-6h",
    "to": "now",
    "autoRefresh": "30s",
    "autoRefreshIntervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
    "fiscalYearStartMonth": 0,
    "hideTimepicker": false
  },
  "variables": [
    {
      "kind": "DatasourceVariable",
      "spec": {
        "name": "datasource",
        "pluginId": "prometheus",
        "label": "Prometheus datasource",
        "description": "",
        "refresh": "onDashboardLoad",
        "regex": "",
        "current": { "text": "", "value": "" },
        "options": [],
        "multi": false,
        "includeAll": false,
        "hide": "dontHide",
        "skipUrlSync": false,
        "allowCustomValue": false
      }
    },
    {
      "kind": "TextVariable",
      "spec": {
        "name": "metric_prefix",
        "label": "Metric prefix",
        "description": "Prefix applied by your collector before gen_ai_client_..., e.g. leave blank, or set to something like otel_ if namespaced.",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": "dontHide",
        "skipUrlSync": false
      }
    },
    {
      "kind": "QueryVariable",
      "spec": {
        "name": "provider",
        "label": "GenAI provider",
        "description": "",
        "query": {
          "kind": "DataQuery",
          "group": "prometheus",
          "version": "v0",
          "datasource": { "name": "${datasource}" },
          "spec": {
            "qryType": 1,
            "query": "label_values(${metric_prefix}gen_ai_client_operation_duration_seconds_count, gen_ai_provider_name)"
          }
        },
        "regex": "",
        "sort": "alphabeticalAsc",
        "refresh": "onDashboardLoad",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "multi": true,
        "includeAll": true,
        "hide": "dontHide",
        "skipUrlSync": false,
        "allowCustomValue": true
      }
    },
    {
      "kind": "QueryVariable",
      "spec": {
        "name": "model",
        "label": "Model",
        "description": "",
        "query": {
          "kind": "DataQuery",
          "group": "prometheus",
          "version": "v0",
          "datasource": { "name": "${datasource}" },
          "spec": {
            "qryType": 1,
            "query": "label_values(${metric_prefix}gen_ai_client_operation_duration_seconds_count{gen_ai_provider_name=~\"$provider\"}, gen_ai_request_model)"
          }
        },
        "regex": "",
        "sort": "alphabeticalAsc",
        "refresh": "onDashboardLoad",
        "current": { "text": ["All"], "value": ["$__all"] },
        "options": [],
        "multi": true,
        "includeAll": true,
        "hide": "dontHide",
        "skipUrlSync": false,
        "allowCustomValue": true
      }
    }
  ],
  "elements": {
    "panel-1": {
      "kind": "Panel",
      "spec": {
        "id": 1,
        "title": "LLM Calls / sec (chat)",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${datasource}" },
                    "spec": {
                      "expr": "sum(rate(${metric_prefix}gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name=\"chat\",gen_ai_provider_name=~\"$provider\",gen_ai_request_model=~\"$model\"}[5m]))",
                      "legendFormat": "chat",
                      "range": true,
                      "instant": false
                    }
                  }
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "stat",
          "version": "13.1.1",
          "spec": {
            "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
            "options": {}
          }
        }
      }
    },
    "panel-2": {
      "kind": "Panel",
      "spec": {
        "id": 2,
        "title": "Tool Calls / sec",
        "description": "",
        "links": [],
