                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${datasource}" },
                    "spec": {
                      "expr": "histogram_quantile(0.99, sum(rate(${metric_prefix}gen_ai_client_operation_duration_seconds_bucket{gen_ai_operation_name=\"chat\",gen_ai_provider_name=~\"$provider\",gen_ai_request_model=~\"$model\"}[5m])) by (le))",
                      "legendFormat": "p99",
                      "range": true,
                      "instant": false
                    }
                  }
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "version": "13.1.1",
          "spec": {
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "options": {}
          }
        }
      }
    },
