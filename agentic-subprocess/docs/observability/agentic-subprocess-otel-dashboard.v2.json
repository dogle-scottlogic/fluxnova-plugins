    "panel-10": {
      "kind": "Panel",
      "spec": {
        "id": 10,
        "title": "LLM Call Duration (p50 / p95 / p99) - chat",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${datasource}" },
                    "spec": {
                      "expr": "histogram_quantile(0.50, sum(rate(${metric_prefix}gen_ai_client_operation_duration_seconds_bucket{gen_ai_operation_name=\"chat\",gen_ai_provider_name=~\"$provider\",gen_ai_request_model=~\"$model\"}[5m])) by (le))",
                      "legendFormat": "p50",
                      "range": true,
                      "instant": false
                    }
                  }
                }
              },
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "B",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "datasource": { "name": "${datasource}" },
                    "spec": {
                      "expr": "histogram_quantile(0.95, sum(rate(${metric_prefix}gen_ai_client_operation_duration_seconds_bucket{gen_ai_operation_name=\"chat\",gen_ai_provider_name=~\"$provider\",gen_ai_request_model=~\"$model\"}[5m])) by (le))",
                      "legendFormat": "p95",
                      "range": true,
